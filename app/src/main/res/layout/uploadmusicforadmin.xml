<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".SongDetailsActivity"> <!-- Nên đặt tên Activity cụ thể -->

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Single Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Single Title*"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_background"
                android:hint="Enter song title"
                android:paddingStart="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:maxLines="1"
                android:inputType="text" />

            <!-- Main Artist -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Main Artist Name*"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editArtist"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_background"
                android:hint="Enter main artist's name"
                android:paddingStart="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:maxLines="1"
                android:inputType="text" />

            <!-- Cover Artwork -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Cover Artwork*"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imageCoverArt"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:background="#333333"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_upload"
                android:contentDescription="Cover Artwork Preview" />

            <Button
                android:id="@+id/btnUploadArtwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:backgroundTint="#535353"
                android:paddingHorizontal="16dp"
                android:text="CHOOSE IMAGE"
                android:textColor="#FFFFFF"
                app:cornerRadius="24dp" />


            <!-- Audio File -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Audio File*"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textAudioFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No file selected."
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingEnd="12dp"/>

                <Button
                    android:id="@+id/btnUploadAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="#535353"
                    android:text="CHOOSE FILE"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="20dp" />
            </LinearLayout>


            <!-- Explicit Lyrics -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Does this song have explicit lyrics?"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/radioGroupExplicit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioExplicitYes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="Yes"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/radioExplicitNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="No"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <!-- Language -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Language*"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- ĐÃ THAY THẾ EditText BẰNG Spinner -->
            <Spinner
                android:id="@+id/spinnerLanguage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_background"
                android:popupBackground="#222222"
                android:spinnerMode="dropdown" />

            <!-- Primary Genre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Primary Genre*"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- XÓA android:entries VÀ android:theme ĐI -->
            <Spinner
                android:id="@+id/spinnerPrimaryGenre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_background"
                android:popupBackground="#222222"
                android:spinnerMode="dropdown" />

            <!-- Secondary Genre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Secondary Genre"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- XÓA android:entries VÀ android:theme ĐI -->
            <Spinner
                android:id="@+id/spinnerSecondaryGenre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_background"
                android:popupBackground="#222222"
                android:spinnerMode="dropdown" />

            <!-- Release Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Release Date"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editReleaseDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_background"
                android:focusable="false"
                android:hint="MM/DD/YYYY"
                android:paddingStart="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <!-- Previously Released -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Previously Released?"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/radioGroupReleased"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/radioReleasedNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="No"
                    android:checked="true"
                    android:textColor="#fcfcfc" />
                <RadioButton
                    android:id="@+id/radioReleasedYes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"
                    android:textColor="#fcfcfc" />
            </RadioGroup>

            <!-- Save Button -->
            <Button
                android:id="@+id/savereleaseandaddsong"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:backgroundTint="#1DB954"
                android:text="SAVE RELEASE AND ADD SONG"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:cornerRadius="24dp" />

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>