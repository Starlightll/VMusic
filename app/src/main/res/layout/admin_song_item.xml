<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/background_gray"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

<RelativeLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:padding="12dp">

<ImageView
    android:id="@+id/image_cover_art_item"
    android:layout_width="80dp"
    android:layout_height="80dp"
    android:layout_alignParentStart="true"
    android:layout_centerVertical="true"
    android:scaleType="centerCrop"
    android:src="@drawable/ic_music_note" />

<LinearLayout
    android:id="@+id/song_info_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_toEndOf="@id/image_cover_art_item"
    android:layout_toStartOf="@+id/buttons_layout"
    android:layout_centerVertical="true"
    android:layout_marginStart="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_song_title_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên bài hát"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/text_artist_name_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên nghệ sĩ"
        android:textColor="@color/gray"
    android:textSize="14sp"
    android:maxLines="1"
    android:ellipsize="end"/>
</LinearLayout>

<LinearLayout
    android:id="@+id/buttons_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentEnd="true"
    android:layout_centerVertical="true"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/btn_edit_song"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_edit"
    android:background="?attr/selectableItemBackgroundBorderless"
    app:tint="@color/white" />

    <ImageButton
        android:id="@+id/btn_delete_song"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_delete"
    android:background="?attr/selectableItemBackgroundBorderless"
    app:tint="@color/white" />
</LinearLayout>

</RelativeLayout>
</androidx.cardview.widget.CardView>