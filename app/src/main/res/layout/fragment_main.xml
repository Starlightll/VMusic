<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/playSongPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF"
        android:translationY="1000dp"
        android:visibility="gone"
        android:elevation="10dp" />

    <FrameLayout
        android:id="@+id/nav_host_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible"
        />

    <FrameLayout
        android:id="@+id/nav_host_search"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/nav_host_library"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />



<!--    <fragment-->
<!--        android:id="@+id/bottom_nav_host_fragment"-->
<!--        android:name="androidx.navigation.fragment.NavHostFragment"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="0dp"-->
<!--        android:layout_weight="1"-->
<!--        app:navGraph="@navigation/bottom_nav_graph"-->
<!--        app:defaultNavHost="false" />-->

    <FrameLayout
        android:id="@+id/miniPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/black_gradient_bottomtop"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:backgroundTint="#00000000"
        app:menu="@menu/bottom_nav_menu" />


</LinearLayout>