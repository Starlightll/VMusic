<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:fitsSystemWindows="true">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_song_details"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Thêm bài hát mới"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/app_bar_layout_details"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Song Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên bài hát*"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nhập tên bài hát"
                android:background="@color/dark_gray"
                android:textColor="@color/white"
                android:textColorHint="@color/gray_hint"
                android:paddingStart="12dp"
                android:inputType="textCapSentences|textMultiLine"
                 />

            <!-- Additional Artists -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Nghệ sĩ*"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- Ô tìm kiếm nghệ sĩ -->
            <AutoCompleteTextView
                android:id="@+id/autocomplete_artist"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Tìm kiếm và thêm nghệ sĩ..."
                android:background="@color/dark_gray"
                android:textColor="@color/white"
                android:textColorHint="@color/gray_hint"
                android:paddingStart="12dp"
                android:inputType="text" />

            <!-- Khu vực hiển thị các nghệ sĩ đã chọn -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipgroup_artists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingVertical="4dp"/>
            <!-- Cover Image -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Ảnh bìa bài hát*"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imageCoverArt"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/dark_gray"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_upload"
                android:contentDescription="Cover Image" />

            <Button
                android:id="@+id/btnUploadArtwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Chọn ảnh"
                android:textColor="@color/white"
                android:backgroundTint="@color/dark_gray" />

            <!-- Audio File -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Tệp bài hát*"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textAudioFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chưa có tệp nào."
                    android:textColor="@color/gray_hint"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingEnd="12dp"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnUploadAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/dark_gray"
                    android:text="Chọn tệp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Lyric File -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Tệp lời bài hát*"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textLyricFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chưa có tệp nào."
                    android:textColor="@color/gray_hint"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingEnd="12dp"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnUploadLyric"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/dark_gray"
                    android:text="Chọn tệp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Genre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Thể loại (chọn nhiều)*"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/genreContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/savereleaseandaddsong"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:text="Lưu bài hát"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:backgroundTint="@color/primary_green" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>