<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:padding="8dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Ảnh bài hát -->
    <ImageView
        android:id="@+id/imgSongThumbnail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Tên bài hát -->
    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tên bài hát"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgSongThumbnail"
        app:layout_constraintTop_toTopOf="@id/imgSongThumbnail"
        app:layout_constraintEnd_toStartOf="@id/btnMenu"
        app:layout_constraintHorizontal_bias="0.0" />

    <!-- Lượt nghe -->
    <TextView
        android:id="@+id/tvListenCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0 lượt nghe"
        android:textColor="#B0B0B0"
        android:textSize="14sp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/tvSongTitle"
        app:layout_constraintTop_toBottomOf="@id/tvSongTitle"
        app:layout_constraintEnd_toEndOf="@id/tvSongTitle" />

    <!-- Nút menu 3 chấm -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
