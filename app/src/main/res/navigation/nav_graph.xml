<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment"
    >

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.vmusic.ui.fragment.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeTabFragment" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/slide_in_right"/>
        <action
            android:id="@+id/action_loginFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:enterAnim="@anim/slide_in_left"/>
        <action
            android:id="@+id/action_loginFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.vmusic.ui.fragment.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.vmusic.ui.fragment.SettingsFragment"
        android:label="Settings">

    </fragment>

    <fragment
        android:id="@+id/homeTabFragment"
        android:name="com.example.vmusic.ui.fragment.HomeTabFragment"
        android:label="Home" >
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.vmusic.ui.fragment.MainFragment"
        android:label="Main">
    </fragment>
    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.vmusic.ui.fragment.AdminDashboardFragment"
        android:label="Admin Dashboard">

        <action
            android:id="@+id/action_adminDashboardFragment_to_adminSongListFragment"
            app:destination="@id/adminSongListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminArtistListFragment"
            app:destination="@id/adminArtistListFragment" />
    </fragment>
    <fragment
        android:id="@+id/adminSongListFragment"
        android:name="com.example.vmusic.ui.fragment.AdminSongListFragment"
        android:label="Admin Song List" />
    <fragment
        android:id="@+id/adminArtistListFragment"
        android:name="com.example.vmusic.ui.fragment.AdminArtistListFragment"
        android:label="fragment_admin_artist_list"
        tools:layout="@layout/fragment_admin_artist_list" >
        <action
            android:id="@+id/action_adminArtistListFragment_to_artistDetailsActivity"
            app:destination="@id/artistDetailsActivity" />
    </fragment>
    <activity
        android:id="@+id/artistDetailsActivity"
        android:name="com.example.vmusic.ui.activity.ArtistDetailsActivity"
        android:label="activity_artist_details"
        tools:layout="@layout/activity_artist_details" />


</navigation>